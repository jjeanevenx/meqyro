# ==============================================================================
# Meqyro — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Browser-Safe Configuration (Client & Server)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Canonical public base URL (must start with https:// in production)
# Note: NEXT_PUBLIC_SITE_URL is the canonical variable; NEXT_PUBLIC_APP_URL is supported for backward compatibility
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database & Supabase Secrets (Server-Only — NEVER expose to browser)
# ------------------------------------------------------------------------------
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Cryptographic salt & pepper for recovery tokens, data requests and IP hashing (min 16 chars)
TOKEN_SECURITY_SECRET=your-production-token-security-secret-32-chars-long

# ------------------------------------------------------------------------------
# 3. Payments (Server-Only)
# ------------------------------------------------------------------------------
# Stripe Checkout uses dynamic payment methods configured in the Dashboard.
# Enable Pix for BRL purchases and cards/wallets for eligible customers.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Stripe File ID (purpose: business_icon) for the Meqyro icon in hosted Checkout.
# Upload one file in each Stripe mode; test and live mode use different file IDs.
STRIPE_BRAND_ICON_FILE_ID=file_...

# ------------------------------------------------------------------------------
# 4. Communications & Email (Server-Only)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM="Meqyro <noreply@meqyro.com>"
# Same dedicated secret in Next.js server and Supabase Edge Function (32+ chars).
REPORT_DELIVERY_SECRET=

# ------------------------------------------------------------------------------
# 5. Security, Admin & Operations (Server-Only)
# ------------------------------------------------------------------------------
# Secret required to access /api/admin/* and /[locale]/admin (min 16 chars)
ADMIN_API_SECRET=admin-super-secure-secret-token-meqyro-v1

# Secret required to execute /api/cron/* reconciliation routines (min 16 chars)
CRON_SECRET=cron-reconcile-secret-token-meqyro-ops

# ------------------------------------------------------------------------------
# 6. Rate Limiting (Server-Only)
# ------------------------------------------------------------------------------
# Options: memory | db | redis
RATE_LIMIT_BACKEND=db

# Optional Upstash Redis for distributed multi-instance rate limiting
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# ------------------------------------------------------------------------------
# 7. Observability (Optional)
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://...
